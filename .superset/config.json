{
  "setup": [
    "command -v arduino-cli >/dev/null || curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | BINDIR=/usr/local/bin sh",
    "arduino-cli config init --overwrite --additional-urls https://raw.githubusercontent.com/espressif/arduino-esp32/gh-pages/package_esp32_index.json",
    "arduino-cli core update-index",
    "arduino-cli core install esp32:esp32"
  ],
  "run": [
    "python3 -m http.server 8000 --directory docs"
  ]
}
